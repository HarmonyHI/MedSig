CUD(with 'logID'){
    Doctor
        Create
            Out:'Stat', 'SID'
            In:
                'userEmail'
                'phone'
                'userName'
                'address'
                'userSex'
                'userBirthday'
                'userPwd'

                'rank'
                'rankNum'
                'operateSID'
        Delete
            Out:'Stat'
            In:
                'userType'
                'operateSID'
                'SID'
        Update
            Out:'Stat'
            In:
                'operateSID'
                'SID'
                'Key':userEmail,phone,userPwd,userName,address,userSex,userBirthday,rank,rankNum
                'Value'
        Read
            Out:Object||'stat'
            In:
                'Key':userEmail,phone,userPwd,userName,address,userSex,userBirthday,rank,rankNum,createTime,SID,adminSID
                'Value'

    Patient/Admin
        Create
            Out:'Stat',
            In:
                'userEmail'
                'phone'
                'userName'
                'address'
                'userSex'
                'userBirthday'
                'userPwd'
                'operateSID'!(doctor create, read patient)
        Delete
            Out:'Stat'
            In:
                'SID'
        Update
            Out:'Stat'
            In:
                'SID'
                'Key':userEmail,phone,userPwd,userName,address,userSex,userBirthday
                'Value'
        Read
            Out:Object||'stat'
            In:
                'Key':userEmail,phone,userName,address,userSex,userBirthday,createTime,SID
                'Value'
    TumorImage:
        Create
            Out:'Stat'
            In:
                'originalPicture'
                'dividedPicture'
                'dimension'
                'tumorSID'
                'doctorSID'
                'operateSID'!
        Delete
            Out:'Stat'
            In:
                'SID'
                'doctorSID'
        Update
            Out:'Stat'
            In:
                'SID'
                'Key':originalPicture,dividedPicture,dimension,tumorSID
                'Value'
                'operateSID'
        Read
            Out:Object||'stat'
            In:
                'Key':originalPicture,dividedPicture,dimension,tumorSID,SID,createTime
                'Value'
    Tumor:
        Create
            Out:'Stat',SID
            In:
                'operateSID'!
                'typeSID'
                'malignant'
                'position'
                'size'
                'doctorSID'
                'patientSID'
                'foundTime'
                'removedTime'
        Delete
            Out:'Stat'
            In:
                'SID'
                'operateSID'!
        Update
            Out:'Stat'
            In:
                'operateSID'!
                'doctorSID'!(doctorUser)
                'patientSID'!(doctorUser)
                'Value'
                'SID'
                'Key':typeSID,malignant,position,size,doctorSID,patientSID,foundTime,removedTime,remark,waitingTrans,transDoctorSID

        Read
            Out:Object||'stat'
            In:
                'Key':typeSID,malignant,position,size,doctorSID,patientSID,foundTime,removedTime,remark,SID,createTime
                'Value'
    TumorType:
        Create
            Out:'Stat','SID'
            In:
                'operateSID'!
                'tumorName'
                'tumorTypeRemark'
        Delete
            Out:'Stat'
            In:
                'SID'
                'operateSID'!
        Update
            Out:'Stat'
            In:
                'operateSID'!
                'Value'
                'SID'
                'Key':tumorName,tumorTypeRemark
        Read
            Out:Object||'stat'
            In:
                'Key':SID,tumorName
                'Value'
    chat_dialog:
        Create
            Out:'Stat','SID'
            In:
                'sendMessage'
                'sendTime'
                'sendAccountSID'
                'recvMessage'
                'recvTime'
                'recvAccountSID'
        Delete
            Out:'Stat'
            In:
                'SID'
                'sendAccountSID'
                'recvAccountSID'
        Read
            Out:Object||'stat'
            In:
                'Key':'sendMessage','sendTime','recvMessage','recvTime'
                'Value'
                'sendAccountSID'
                'recvAccountSID'
}

create{
    'stat'
    'ID'
}
R{
    'ID'
}
login_and_logout{
    'logKey'
    'userPwd'
    'IO' // vue 0 out 1 in
    return:
    'stat'
    'SID'
    'userPwd'
    'userType'
}
multiple_read{
    'num'
    'objType'
    'packList'
}