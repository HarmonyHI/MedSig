# 后端环境变量模板
# 使用方法：复制为 backend/.env 后填入真实值，再自行 source 或由启动脚本注入。
# 注意 backend/ClientMain/settings.py 直接读进程环境变量，不会自动加载 .env，
# 所以最省事的做法是在启动前 `export` 这些值，或改用 python-dotenv。

# ---- MySQL 连接 ----
DB_NAME=TumorSegDB
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# ---- Django ----
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=django-insecure-dev-only-placeholder-change-me
